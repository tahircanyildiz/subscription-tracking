# Supabase — https://supabase.com/dashboard/project/_/settings/api
# Proje oluşturduktan sonra bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Yalnızca sunucu tarafında kullanılır (cron/bildirim işleri). Asla NEXT_PUBLIC_ öneki eklemeyin.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Zamanlanmış bildirim endpoint'ini korumak için rastgele uzun bir değer (örn. `openssl rand -hex 32`)
CRON_SECRET=your-cron-secret

# E-posta bildirimleri (opsiyonel) — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Abonelik Dedektifi <bildirim@example.com>

# Uygulamanın temel URL'i (e-posta bağlantıları için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
